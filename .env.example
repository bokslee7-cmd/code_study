# Copy to .env and fill in real values. Never commit .env.

# Database (backend runs locally; use host "db" only when the backend runs inside Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codelearning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelearning

# Redis
REDIS_URL=redis://localhost:6379/0

# Google AI (Gemini)
GOOGLE_API_KEY=your-google-ai-api-key-here

# JWT secrets (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret

# App
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173
# Refresh-token cookie Secure flag: false for local http development, true in production (https)
COOKIE_SECURE=false

# File storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# Database connection pool (optional; defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# JWT (JWT_SECRET_KEY must be at least 32 characters; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-32+chars
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Local dev test account (created by browser tests T039-T041; delete before any shared/production use)
TEST_USER_EMAIL=browser-test@example.com
TEST_USER_PASSWORD=TestPass-2026!
